# Copy to .env (server/.env is git-ignored). See docs/BACKEND.md for every variable.

PORT=8790
# Public https URL of this server. DigiLocker returns here, so it must be https in production.
PUBLIC_BASE_URL=https://getyourlawyer-api.onrender.com
DATA_DIR=./data                 # relative to the server/ folder
# production turns on safety checks (refuses DEV_OTP, warns without JWT_SECRET)
# NODE_ENV=production
# JWT_SECRET=a-long-random-string
# SUPPORT_EMAIL=support@example.com

# --- Database: MongoDB. Empty = a JSON file in DATA_DIR (development only) ---
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/getyourlawyer
TRUST_PROXY=1
# Extra web origins allowed for CORS (comma separated). The Android WebView origin and localhost are built in.
ALLOWED_ORIGINS=

# --- First admin (only used when no admin exists yet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- DigiLocker: mock (default with no credentials) | setu | oauth | aggregator ---
DL_PROVIDER=mock
# DL_PROVIDER=setu
# SETU_ENV=sandbox                  # sandbox | production
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
# SETU_PRODUCT_INSTANCE_ID=
DL_PURPOSE=Identity verification for legal services
APP_RETURN_URL=savrogyl://digilocker/done

# --- OTP: console | twilio_verify | twilio | msg91 ---
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=VA...
# DEMO OTP: a fixed code that signs in any number, no SMS sent. Remove for production (server refuses to start with it in production).
DEMO_OTP=123456
# DEVELOPMENT ONLY: return the OTP in the API response so you can sign in without SMS. NEVER in production.
# DEV_OTP=1

# --- Push notifications (Firebase service-account key) ---
# FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

